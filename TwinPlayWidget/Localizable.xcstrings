    "Star a game in TwinPlay to see it here": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiere ein Spiel in TwinPlay, um es hier zu sehen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca un juego con una estrella en TwinPlay para verlo aquí"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un jeu aux favoris dans TwinPlay pour le voir ici"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un gioco ai preferiti in TwinPlay per vederlo qui"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TwinPlayでゲームをお気に入りにするとここに表示されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TwinPlay에서 게임을 즐겨찾기하면 여기에 표시됩니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque um jogo com estrela no TwinPlay para vê-lo aqui"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 TwinPlay 中收藏游戏即可在此看到"
          }
        }
      }
    },
