    "NSPhotoLibraryAddUsageDescription": {
      "comment": "Privacy - Photo Library Additions Usage Description",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TwinPlay sichert deine Bildschirmfotos und Gameplay-Videos in Fotos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TwinPlay saves your screenshots and gameplay videos to Photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TwinPlay guarda tus capturas de pantalla y videos de juego en Fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TwinPlay enregistre vos captures d'écran et vidéos de jeu dans Photos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "TwinPlay salva screenshot e video di gioco in Foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TwinPlayはスクリーンショットとゲームプレイ動画を写真に保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TwinPlay는 스크린샷과 게임플레이 비디오를 사진에 저장합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O TwinPlay salva suas capturas de tela e vídeos de jogo no Fotos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TwinPlay 会将你的截图和游戏视频保存到“照片”。"
          }
        }
      }
    }
  },
  "version": "1.0"
