    "One tap: sharpest settings that hold 60 fps. Lowers 3D resolution automatically if needed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Tippen: schärfste Einstellungen, die 60 fps halten. Senkt die 3D-Auflösung bei Bedarf automatisch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un toque: los ajustes más nítidos que mantienen 60 fps. Baja la resolución 3D automáticamente si hace falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une touche : les réglages les plus nets qui tiennent 60 fps. Réduit la résolution 3D automatiquement si besoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tocco: le impostazioni più nitide che reggono i 60 fps. Riduce la risoluzione 3D automaticamente se serve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワンタップで60fpsを保てる最もシャープな設定に。必要に応じて3D解像度を自動で下げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 탭으로 60fps를 유지하는 가장 선명한 설정. 필요하면 3D 해상도를 자동으로 낮춥니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um toque: os ajustes mais nítidos que mantêm 60 fps. Reduz a resolução 3D automaticamente se precisar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一键设为能保持 60 fps 的最清晰设置。必要时自动降低 3D 分辨率。"
          }
        }
      }
    },
