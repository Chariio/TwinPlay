    "Raise the touch point above your finger so it does not hide what you tap.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hebt den Berührungspunkt über deinen Finger, damit er nicht verdeckt, was du antippst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube el punto de toque por encima del dedo para que no tape lo que tocas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Place le point de contact au-dessus du doigt pour ne pas masquer ce que vous touchez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alza il punto di tocco sopra il dito così non copre ciò che tocchi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タッチ位置を指より上にずらし、タップする場所が隠れないようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터치 지점을 손가락 위로 올려 탭하는 곳이 가려지지 않게 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eleva o ponto de toque acima do dedo para não esconder o que você toca."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将触点抬高到手指上方，避免遮挡点按的位置。"
          }
        }
      }
    },
