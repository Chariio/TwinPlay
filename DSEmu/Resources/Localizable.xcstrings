    "Found art for %lld of %lld games. For the rest, use Find Box Art on the game.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cover für %1$lld von %2$lld Spielen gefunden. Für die übrigen nutze „Cover suchen“ beim Spiel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found art for %1$lld of %2$lld games. For the rest, use Find Box Art on the game."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se encontraron portadas para %1$lld de %2$lld juegos. Para el resto, usa Buscar portada en el juego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaquettes trouvées pour %1$lld jeux sur %2$lld. Pour les autres, utilisez Trouver la jaquette sur le jeu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copertine trovate per %1$lld giochi su %2$lld. Per gli altri, usa Trova copertina sul gioco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld本中%1$lld本のパッケージが見つかりました。残りはゲームの「パッケージを探す」を使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임 %2$lld개 중 %1$lld개의 아트를 찾았습니다. 나머지는 게임에서 박스 아트 찾기를 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Capas encontradas para %1$lld de %2$lld jogos. Para o resto, use Buscar capa no jogo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已为 %2$lld 款游戏中的 %1$lld 款找到封面。其余游戏请使用“查找封面”。"
          }
        }
      }
    },
    "Found art for all %lld games.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cover für alle %lld Spiele gefunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se encontraron portadas para los %lld juegos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaquettes trouvées pour les %lld jeux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copertine trovate per tutti i %lld giochi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld本すべてのパッケージが見つかりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임 %lld개 모두의 아트를 찾았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Capas encontradas para todos os %lld jogos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已为全部 %lld 款游戏找到封面。"
          }
        }
      }
    },
    "Found title screens online for %lld of %lld games. The others use the screen TwinPlay captured.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Titelbilder online für %1$lld von %2$lld Spielen gefunden. Die übrigen nutzen das von TwinPlay aufgenommene Bild."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found title screens online for %1$lld of %2$lld games. The others use the screen TwinPlay captured."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se encontraron pantallas de título en línea para %1$lld de %2$lld juegos. Los demás usan la pantalla que capturó TwinPlay."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrans titres trouvés en ligne pour %1$lld jeux sur %2$lld. Les autres utilisent l'écran capturé par TwinPlay."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Schermate del titolo trovate online per %1$lld giochi su %2$lld. Gli altri usano la schermata acquisita da TwinPlay."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld本中%1$lld本のタイトル画面がオンラインで見つかりました。残りはTwinPlayがキャプチャした画面を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임 %2$lld개 중 %1$lld개의 타이틀 화면을 온라인에서 찾았습니다. 나머지는 TwinPlay가 캡처한 화면을 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Telas de título encontradas online para %1$lld de %2$lld jogos. Os outros usam a tela capturada pelo TwinPlay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在线找到 %2$lld 款游戏中 %1$lld 款的标题画面。其余游戏使用 TwinPlay 截取的画面。"
          }
        }
      }
    },
