          }
        }
      }
    },
    "This game only. 2D graphics are stretched; objects may pop in at the sides.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur dieses Spiel. 2D-Grafik wird gestreckt; an den Seiten können Objekte plötzlich auftauchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo este juego. Los gráficos 2D se estiran; pueden aparecer objetos de golpe en los lados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce jeu uniquement. Les graphismes 2D sont étirés ; des objets peuvent apparaître soudainement sur les côtés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo questo gioco. La grafica 2D viene allungata; gli oggetti possono comparire all'improvviso ai lati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このゲームのみ。2Dグラフィックは引き伸ばされ、画面端でオブジェクトが急に現れることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 게임에만 적용됩니다. 2D 그래픽이 늘어나며 가장자리에서 오브젝트가 갑자기 나타날 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só este jogo. Os gráficos 2D são esticados; objetos podem surgir de repente nas laterais."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅此游戏。2D 画面会被拉伸；两侧可能出现物体突然显现。"
          }
        }
      }
    },
