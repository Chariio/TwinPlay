    "Lowers the 3D resolution if the game can't keep 60 fps.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senkt die 3D-Auflösung, wenn das Spiel keine 60 fps hält."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja la resolución 3D si el juego no puede mantener 60 fps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduit la résolution 3D si le jeu ne tient pas 60 fps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riduce la risoluzione 3D se il gioco non regge i 60 fps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームが60fpsを保てない場合は3D解像度を下げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임이 60fps를 유지하지 못하면 3D 해상도를 낮춥니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduz a resolução 3D se o jogo não mantiver 60 fps."
          }
        },
        "zh-Hans": {
