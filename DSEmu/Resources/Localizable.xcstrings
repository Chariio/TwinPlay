    "Button mapping, controller shortcuts (screen mode, quick save, fast-forward…) and joystick calibration are on the controller screen.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tastenbelegung, Controller-Kurzbefehle (Bildschirmmodus, Schnellspeichern, Vorspulen…) und Joystick-Kalibrierung findest du auf dem Controller-Bildschirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La asignación de botones, los atajos del control (modo de pantalla, guardado rápido, avance rápido…) y la calibración del joystick están en la pantalla de controles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'attribution des boutons, les raccourcis manette (mode d'écran, sauvegarde rapide, avance rapide…) et le calibrage du joystick se trouvent sur l'écran des manettes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappatura dei tasti, scorciatoie del controller (modalità schermo, salvataggio rapido, avanti veloce…) e calibrazione del joystick sono nella schermata dei controller."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボタン割り当て、コントローラーのショートカット（画面モード、クイックセーブ、早送りなど）、ジョイスティック調整はコントローラー画面にあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버튼 매핑, 컨트롤러 단축키(화면 모드, 빠른 저장, 빨리 감기 등), 조이스틱 보정은 컨트롤러 화면에 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mapeamento de botões, os atalhos do controle (modo de tela, salvamento rápido, avanço rápido…) e a calibração do joystick ficam na tela de controles."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键映射、手柄快捷键（屏幕模式、快速存档、快进等）和摇杆校准都在手柄设置界面中。"
          }
        }
      }
    },
