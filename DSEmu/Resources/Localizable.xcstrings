    "Auto quality is using %lldx right now to keep the game smooth.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-Qualität nutzt gerade %lldx, damit das Spiel flüssig bleibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La calidad automática usa %lldx ahora para que el juego vaya fluido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La qualité auto utilise %lldx pour garder le jeu fluide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La qualità automatica sta usando %lldx per mantenere il gioco fluido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームを滑らかに保つため、自動画質が現在%lldxを使用しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임을 부드럽게 유지하기 위해 자동 화질이 지금 %lldx를 사용 중입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A qualidade automática está usando %lldx agora para manter o jogo fluido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为保持游戏流畅，自动画质当前使用 %lldx。"
          }
        }
      }
    },
