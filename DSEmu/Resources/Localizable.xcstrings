    "Remembered for this game. An open iPhone Duo always shows both screens.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dieses Spiel gespeichert. Ein aufgeklapptes iPhone Duo zeigt immer beide Bildschirme."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se recuerda para este juego. Un iPhone Duo abierto siempre muestra ambas pantallas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mémorisé pour ce jeu. Un iPhone Duo ouvert affiche toujours les deux écrans."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Memorizzato per questo gioco. Un iPhone Duo aperto mostra sempre entrambi gli schermi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このゲーム用に記憶されます。開いたiPhone Duoでは常に両方の画面を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 게임에 대해 기억됩니다. 펼친 iPhone Duo는 항상 두 화면을 모두 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembrado para este jogo. Um iPhone Duo aberto sempre mostra as duas telas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将为此游戏记住此设置。展开的 iPhone Duo 始终显示双屏。"
          }
        }
      }
    },
