    "Thanks for downloading TwinPlay! I hope it brings back great memories. Enjoy your games. 💜": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke, dass du TwinPlay geladen hast! Ich hoffe, es weckt schöne Erinnerungen. Viel Spaß mit deinen Spielen. 💜"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Gracias por descargar TwinPlay! Espero que te traiga grandes recuerdos. Disfruta tus juegos. 💜"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci d'avoir téléchargé TwinPlay ! J'espère qu'il vous rappellera de beaux souvenirs. Bon jeu. 💜"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie per aver scaricato TwinPlay! Spero ti riporti alla mente bei ricordi. Buon divertimento. 💜"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TwinPlayをダウンロードしていただきありがとうございます！素敵な思い出がよみがえりますように。ゲームを楽しんでください。💜"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TwinPlay를 다운로드해 주셔서 감사합니다! 좋은 추억이 떠오르길 바랍니다. 즐거운 게임 되세요. 💜"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado por baixar o TwinPlay! Espero que traga ótimas lembranças. Divirta-se com seus jogos. 💜"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "感谢下载 TwinPlay！希望它能带回美好的回忆。尽情享受游戏吧。💜"
          }
        }
      }
    },
    "Thanks for your support!": {
      "localizations": {
