    "Automatic detection works for most games. Change it only if the game reports save errors.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die automatische Erkennung funktioniert bei den meisten Spielen. Ändere sie nur, wenn das Spiel Speicherfehler meldet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La detección automática funciona en la mayoría de los juegos. Cámbiala solo si el juego da errores al guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La détection automatique fonctionne pour la plupart des jeux. Ne la changez que si le jeu signale des erreurs de sauvegarde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il rilevamento automatico funziona con quasi tutti i giochi. Cambialo solo se il gioco segnala errori di salvataggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動検出はほとんどのゲームで機能します。ゲームがセーブエラーを出す場合のみ変更してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대부분의 게임에서 자동 감지가 작동합니다. 게임에서 저장 오류가 날 때만 변경하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A detecção automática funciona na maioria dos jogos. Mude só se o jogo mostrar erros ao salvar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动检测适用于大多数游戏。仅当游戏提示存档错误时才更改。"
          }
        }
      }
    },
