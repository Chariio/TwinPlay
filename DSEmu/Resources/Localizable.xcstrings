    "Save states capture the exact moment. Quick save and load use slot 1.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speicherstände halten den genauen Moment fest. Schnellspeichern und -laden nutzen Platz 1."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los estados guardados capturan el momento exacto. El guardado y la carga rápidos usan la ranura 1."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes instantanées capturent le moment exact. La sauvegarde et le chargement rapides utilisent l'emplacement 1."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I salvataggi rapidi catturano il momento esatto. Salvataggio e caricamento rapidi usano lo slot 1."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステートセーブはその瞬間をそのまま保存します。クイックセーブ/ロードはスロット1を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상태 저장은 정확한 순간을 기록합니다. 빠른 저장과 불러오기는 슬롯 1을 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os estados salvos capturam o momento exato. O salvamento e o carregamento rápidos usam o slot 1."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即时存档会记录确切的瞬间。快速存档和读档使用存档位 1。"
          }
        }
      }
    },
