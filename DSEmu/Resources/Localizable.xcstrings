    "The auto slot is written when you leave the game or the app goes to the background.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Auto-Platz wird geschrieben, wenn du das Spiel verlässt oder die App in den Hintergrund geht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ranura automática se escribe al salir del juego o cuando la app pasa a segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'emplacement auto est enregistré quand vous quittez le jeu ou que l'app passe en arrière-plan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
