    "A crosshair where the stylus touches the DS screen.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Fadenkreuz dort, wo der Stift den DS-Bildschirm berührt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una mira donde el lápiz toca la pantalla del DS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un réticule là où le stylet touche l'écran DS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mirino nel punto in cui il pennino tocca lo schermo DS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タッチペンがDSの画面に触れた位置に十字を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스타일러스가 DS 화면에 닿는 위치에 십자선을 표시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma mira onde a caneta toca a tela do DS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在触控笔触碰 DS 屏幕的位置显示十字准星。"
          }
        }
      }
    },
    "A light tap every time you press an on-screen button. Also in the in-game menu.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein leichtes Tippen bei jedem Druck auf eine Bildschirmtaste. Auch im Spielmenü."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vibración ligera cada vez que tocas un botón en pantalla. También está en el menú del juego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une légère vibration à chaque appui sur un bouton à l'écran. Aussi dans le menu du jeu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una leggera vibrazione a ogni pressione di un tasto sullo schermo. Anche nel menu di gioco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面上のボタンを押すたびに軽い振動。ゲーム内メニューでも設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
