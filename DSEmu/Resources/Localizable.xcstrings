    "Choose an action, then press the button you want. A button can trigger only one action. X clears an action.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Aktion und drücke dann die gewünschte Taste. Eine Taste kann nur eine Aktion auslösen. X löscht eine Aktion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una acción y luego pulsa el botón que quieras. Cada botón activa una sola acción. X borra una acción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une action, puis appuyez sur le bouton voulu. Un bouton ne déclenche qu'une action. X efface une action."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un'azione, poi premi il tasto che vuoi. Un tasto attiva una sola azione. X cancella un'azione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクションを選んでから、使いたいボタンを押します。1つのボタンに割り当てられるアクションは1つだけ。Xでアクションを解除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동작을 고른 뒤 원하는 버튼을 누르세요. 버튼 하나에는 동작 하나만 지정됩니다. X는 동작을 지웁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma ação e aperte o botão que quiser. Cada botão aciona só uma ação. X apaga uma ação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个操作，然后按下想用的按键。每个按键只能触发一个操作。X 可清除操作。"
          }
        }
      }
    },
