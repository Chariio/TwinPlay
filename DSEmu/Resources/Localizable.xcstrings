    "%@ saved, but its CRC32 %@ doesn't match a known good dump. It may not work.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ gespeichert, aber die CRC32 %2$@ passt zu keinem bekannten guten Dump. Möglicherweise funktioniert es nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ saved, but its CRC32 %2$@ doesn't match a known good dump. It may not work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ guardado, pero su CRC32 %2$@ no coincide con una copia válida conocida. Puede que no funcione."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ enregistré, mais son CRC32 %2$@ ne correspond à aucun dump valide connu. Il risque de ne pas fonctionner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ salvato, ma il suo CRC32 %2$@ non corrisponde a un dump valido noto. Potrebbe non funzionare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ を保存しましたが、CRC32 %2$@ は既知の正常なダンプと一致しません。動作しない可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 저장됨. 하지만 CRC32 %2$@이(가) 알려진 정상 덤프와 일치하지 않아 작동하지 않을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ salvo, mas o CRC32 %2$@ não corresponde a um dump válido conhecido. Pode não funcionar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已保存，但其 CRC32 %2$@ 与已知的正确转储不符，可能无法使用。"
          }
        }
      }
    },
