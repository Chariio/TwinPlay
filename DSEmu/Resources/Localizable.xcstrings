    "Glass Violet is the icon on the Home Screen until you pick another. Alternate icons can be changed back here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasviolett bleibt das Home-Bildschirm-Symbol, bis du ein anderes wählst. Alternative Symbole kannst du hier wieder ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Violeta cristal es el icono de la pantalla de inicio hasta que elijas otro. Los iconos alternativos se pueden volver a cambiar aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Violet verre reste l’icône de l’écran d’accueil jusqu’à ce que vous en choisissiez une autre. Les icônes alternatives se changent ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viola vetro resta l’icona della schermata Home finché non ne scegli un’altra. Le icone alternative si cambiano di nuovo qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のアイコンを選ぶまで、ホーム画面はグラスバイオレットです。別のアイコンもここから戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 아이콘을 고르기 전까지 홈 화면은 글래스 바이올렛입니다. 다른 아이콘도 여기서 다시 바꿀 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Violeta vidro fica na Tela de Início até você escolher outro. Os ícones alternativos podem ser trocados de novo aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你另选之前，主屏幕图标是玻璃紫。也可以在这里改回其他图标。"
          }
        }
      }
    }
  },
  "version": "1.0"
