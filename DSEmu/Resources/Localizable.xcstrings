    "The game file is removed from TwinPlay. Its saves and save states are kept.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spieldatei wird aus TwinPlay entfernt. Spielstände und Speicherstände bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo del juego se quita de TwinPlay. Sus partidas y estados guardados se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier du jeu est retiré de TwinPlay. Ses sauvegardes et sauvegardes instantanées sont conservées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file del gioco viene rimosso da TwinPlay. I salvataggi e i salvataggi rapidi vengono conservati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームファイルはTwinPlayから削除されます。セーブデータとステートセーブは残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임 파일이 TwinPlay에서 제거됩니다. 저장 데이터와 상태 저장은 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo do jogo é removido do TwinPlay. Os saves e estados salvos são mantidos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏文件将从 TwinPlay 中移除，其存档和即时存档会保留。"
          }
        }
      }
    },
    "The game starts with empty save memory. A backup of the old file is kept (.sav.bak in the Saves folder).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Spiel startet mit leerem Speicher. Eine Sicherung der alten Datei bleibt erhalten (.sav.bak im Ordner Saves)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El juego empieza con la memoria de guardado vacía. Se conserva una copia del archivo anterior (.sav.bak en la carpeta Saves)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu démarre avec une mémoire de sauvegarde vide. Une copie de l'ancien fichier est conservée (.sav.bak dans le dossier Saves)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gioco parte con la memoria di salvataggio vuota. Viene conservato un backup del vecchio file (.sav.bak nella cartella Saves)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームは空のセーブメモリで始まります。古いファイルのバックアップは残ります（Savesフォルダ内の .sav.bak）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임이 빈 저장 메모리로 시작됩니다. 이전 파일의 백업은 유지됩니다(Saves 폴더의 .sav.bak)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O jogo começa com a memória de save vazia. Um backup do arquivo antigo é mantido (.sav.bak na pasta Saves)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏将以空白存档内存启动。旧文件的备份会保留（Saves 文件夹中的 .sav.bak）。"
          }
        }
      }
    },
    "The games folder is no longer available. Choose it again in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Spieleordner ist nicht mehr verfügbar. Wähle ihn in den Einstellungen erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta de juegos ya no está disponible. Elígela de nuevo en Configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier de jeux n'est plus disponible. Choisissez-le à nouveau dans les Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella dei giochi non è più disponibile. Sceglila di nuovo nelle Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームフォルダが見つかりません。設定でもう一度選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "게임 폴더를 더 이상 사용할 수 없습니다. 설정에서 다시 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta de jogos não está mais disponível. Escolha-a de novo nos Ajustes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏文件夹已不可用。请在设置中重新选择。"
          }
        }
      }
    },
    "The menu button always stays on screen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Menütaste bleibt immer auf dem Bildschirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El botón de menú siempre permanece en pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bouton de menu reste toujours à l'écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pulsante del menu resta sempre sullo schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューボタンは常に画面に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 버튼은 항상 화면에 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O botão de menu sempre fica na tela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单按钮始终显示在屏幕上。"
          }
        }
      }
    },
    "The old save file did not match this game and was kept as a .bak backup.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die alte Speicherdatei passte nicht zu diesem Spiel und wurde als .bak-Sicherung behalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo de partida anterior no correspondía a este juego y se guardó como copia .bak."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ancien fichier de sauvegarde ne correspondait pas à ce jeu et a été conservé en copie .bak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il vecchio file di salvataggio non corrispondeva a questo gioco ed è stato conservato come backup .bak."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古いセーブファイルはこのゲームと一致しなかったため、.bakバックアップとして保存しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 저장 파일이 이 게임과 맞지 않아 .bak 백업으로 보관했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo de save antigo não correspondia a este jogo e foi mantido como backup .bak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧存档文件与此游戏不符，已保留为 .bak 备份。"
          }
        }
      }
    },
    "The purchase couldn't be verified.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kauf konnte nicht bestätigt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar la compra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de vérifier l'achat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare l'acquisto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入を確認できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구입을 확인할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar a compra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证购买。"
          }
        }
      }
    },
    "The skin colours the whole play area (shell, screen surround and controls) and the lid. DS games use the DS skin; GBA, Game Boy and Game Boy Color games share the single-screen skin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Skin färbt den gesamten Spielbereich (Gehäuse, Bildschirmrahmen und Steuerung) und den Deckel. DS-Spiele nutzen den DS-Skin; GBA-, Game Boy- und Game Boy Color-Spiele teilen sich den Ein-Bildschirm-Skin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El skin da color a toda el área de juego (carcasa, marco de pantalla y controles) y a la tapa. Los juegos de DS usan el skin de DS; los de GBA, Game Boy y Game Boy Color comparten el skin de una pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le skin colore toute la zone de jeu (coque, contour d'écran et commandes) et le couvercle. Les jeux DS utilisent le skin DS ; les jeux GBA, Game Boy et Game Boy Color partagent le skin à écran unique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La skin colora tutta l'area di gioco (scocca, cornice dello schermo e comandi) e il coperchio. I giochi DS usano la skin DS; i giochi GBA, Game Boy e Game Boy Color condividono la skin a schermo singolo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキンはプレイエリア全体（本体、画面の枠、操作ボタン）とふたの色を変えます。DSのゲームはDSスキンを、GBA・Game Boy・Game Boy Colorのゲームはシングル画面スキンを共有します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스킨은 플레이 영역 전체(본체, 화면 테두리, 컨트롤)와 덮개의 색상을 바꿉니다. DS 게임은 DS 스킨을 사용하고, GBA, Game Boy, Game Boy Color 게임은 단일 화면 스킨을 함께 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A skin colore toda a área de jogo (carcaça, moldura da tela e controles) e a tampa. Jogos de DS usam a skin de DS; jogos de GBA, Game Boy e Game Boy Color compartilham a skin de tela única."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "皮肤会为整个游戏区域（外壳、屏幕边框和按键）及翻盖着色。DS 游戏使用 DS 皮肤；GBA、Game Boy 和 Game Boy Color 游戏共用单屏皮肤。"
          }
        }
      }
    },
    "This app does not include any games, BIOS, firmware or cover art. Use only games you own. The emulation core is experimental and some games do not run correctly yet.": {
      "comment": "Library disclaimer",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App enthält keine Spiele, BIOS, Firmware oder Cover. Nutze nur Spiele, die du besitzt. Der Emulationskern ist experimentell und manche Spiele laufen noch nicht richtig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app no incluye juegos, BIOS, firmware ni portadas. Usa solo juegos que te pertenezcan. El núcleo de emulación es experimental y algunos juegos aún no funcionan correctamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette app n'inclut aucun jeu, BIOS, firmware ni jaquette. N'utilisez que des jeux que vous possédez. Le cœur d'émulation est expérimental et certains jeux ne fonctionnent pas encore correctement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa app non include giochi, BIOS, firmware o copertine. Usa solo giochi che possiedi. Il core di emulazione è sperimentale e alcuni giochi non funzionano ancora correttamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このAppにはゲーム、BIOS、ファームウェア、パッケージ画像は含まれていません。所有しているゲームのみを使用してください。エミュレーションコアは実験的なもので、一部のゲームはまだ正しく動作しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱에는 게임, BIOS, 펌웨어, 커버 아트가 포함되어 있지 않습니다. 소유한 게임만 사용하세요. 에뮬레이션 코어는 실험 단계이며 일부 게임은 아직 제대로 실행되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este app não inclui jogos, BIOS, firmware nem capas. Use só jogos que você tem. O núcleo de emulação é experimental e alguns jogos ainda não rodam direito."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本 App 不包含任何游戏、BIOS、固件或封面。请仅使用你拥有的游戏。模拟核心为实验性，部分游戏目前还无法正常运行。"
          }
        }
      }
    },
    "This device doesn't support alternate icons.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät unterstützt keine alternativen Symbole."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no admite iconos alternativos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne prend pas en charge les icônes alternatives."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non supporta icone alternative."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスは代替アイコンに対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기는 대체 아이콘을 지원하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este aparelho não suporta ícones alternativos."
          }
        },
        "zh-Hans": {
