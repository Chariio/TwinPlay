    "Couldn't read that file. If it's in iCloud Drive, open it once in Files so it downloads, then try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datei konnte nicht gelesen werden. Liegt sie in iCloud Drive, öffne sie einmal in Dateien, damit sie geladen wird, und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer ese archivo. Si está en iCloud Drive, ábrelo una vez en Archivos para que se descargue y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire ce fichier. S'il est dans iCloud Drive, ouvrez-le une fois dans Fichiers pour le télécharger, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere il file. Se è in iCloud Drive, aprilo una volta in File per scaricarlo, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのファイルを読み込めませんでした。iCloud Driveにある場合は、「ファイル」で一度開いてダウンロードしてから再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 읽을 수 없습니다. iCloud Drive에 있다면 파일 앱에서 한 번 열어 다운로드한 뒤 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler esse arquivo. Se estiver no iCloud Drive, abra-o uma vez no Arquivos para baixar e tente de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取该文件。如果它在 iCloud 云盘中，请先在“文件”中打开一次以下载，然后重试。"
          }
        }
      }
    },
