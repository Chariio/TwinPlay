    "Not signed in to iCloud. Sign in and turn on iCloud Drive in the Settings app; saves stay on this device until then.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht bei iCloud angemeldet. Melde dich an und aktiviere iCloud Drive in der Einstellungen-App; bis dahin bleiben die Spielstände auf diesem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No has iniciado sesión en iCloud. Inicia sesión y activa iCloud Drive en la app Configuración; mientras tanto, las partidas se quedan en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n'êtes pas connecté à iCloud. Connectez-vous et activez iCloud Drive dans l'app Réglages ; d'ici là, les sauvegardes restent sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai effettuato l'accesso a iCloud. Accedi e attiva iCloud Drive nell'app Impostazioni; fino ad allora i salvataggi restano su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudにサインインしていません。設定Appでサインインし、iCloud Driveをオンにしてください。それまでセーブはこのデバイスに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud에 로그인하지 않았습니다. 설정 앱에서 로그인하고 iCloud Drive를 켜세요. 그 전까지 저장 데이터는 이 기기에 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não entrou no iCloud. Entre e ative o iCloud Drive no app Ajustes; até lá, os saves ficam neste aparelho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未登录 iCloud。请在“设置”App 中登录并打开 iCloud 云盘；在此之前存档会保留在此设备上。"
          }
        }
      }
    },
    "Nothing to capture yet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts aufzunehmen."
