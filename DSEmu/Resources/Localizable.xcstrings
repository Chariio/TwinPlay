    "GameShark v1/v2 raw (XXXXXXXX YYYYYYYY) or CodeBreaker raw (XXXXXXXX YYYY). Encrypted codes aren't supported.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GameShark v1/v2 unverschlüsselt (XXXXXXXX YYYYYYYY) oder CodeBreaker unverschlüsselt (XXXXXXXX YYYY). Verschlüsselte Codes werden nicht unterstützt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GameShark v1/v2 sin cifrar (XXXXXXXX YYYYYYYY) o CodeBreaker sin cifrar (XXXXXXXX YYYY). Los códigos cifrados no son compatibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GameShark v1/v2 brut (XXXXXXXX YYYYYYYY) ou CodeBreaker brut (XXXXXXXX YYYY). Les codes chiffrés ne sont pas pris en charge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GameShark v1/v2 non cifrati (XXXXXXXX YYYYYYYY) o CodeBreaker non cifrati (XXXXXXXX YYYY). I codici cifrati non sono supportati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GameShark v1/v2（暗号化なし：XXXXXXXX YYYYYYYY）またはCodeBreaker（暗号化なし：XXXXXXXX YYYY）。暗号化されたコードには対応していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GameShark v1/v2 원본(XXXXXXXX YYYYYYYY) 또는 CodeBreaker 원본(XXXXXXXX YYYY). 암호화된 코드는 지원하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "GameShark v1/v2 sem criptografia (XXXXXXXX YYYYYYYY) ou CodeBreaker sem criptografia (XXXXXXXX YYYY). Códigos criptografados não são suportados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GameShark v1/v2 未加密码（XXXXXXXX YYYYYYYY）或 CodeBreaker 未加密码（XXXXXXXX YYYY）。不支持加密代码。"
          }
        }
      }
    },
