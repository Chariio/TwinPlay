    "iCloud isn't available for TwinPlay right now (check iCloud Drive in the Settings app). Saves stay on this device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ist für TwinPlay gerade nicht verfügbar (prüfe iCloud Drive in der Einstellungen-App). Spielstände bleiben auf diesem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud no está disponible para TwinPlay ahora (revisa iCloud Drive en la app Configuración). Las partidas se quedan en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud n'est pas disponible pour TwinPlay pour le moment (vérifiez iCloud Drive dans l'app Réglages). Les sauvegardes restent sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud non è disponibile per TwinPlay al momento (controlla iCloud Drive nell'app Impostazioni). I salvataggi restano su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在TwinPlayではiCloudを利用できません（設定AppでiCloud Driveを確認してください）。セーブはこのデバイスに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 TwinPlay에서 iCloud를 사용할 수 없습니다(설정 앱에서 iCloud Drive를 확인하세요). 저장 데이터는 이 기기에 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iCloud não está disponível para o TwinPlay agora (verifique o iCloud Drive no app Ajustes). Os saves ficam neste aparelho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TwinPlay 目前无法使用 iCloud（请在“设置”App 中检查 iCloud 云盘）。存档会保留在此设备上。"
          }
        }
      }
    },
