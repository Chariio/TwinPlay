    "Cheats can crash games or corrupt saves; make a save state first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheats können Spiele abstürzen lassen oder Spielstände beschädigen; lege vorher einen Speicherstand an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los trucos pueden bloquear juegos o dañar partidas; crea antes un estado guardado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les triches peuvent planter le jeu ou corrompre les sauvegardes ; faites d'abord une sauvegarde instantanée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I trucchi possono bloccare i giochi o rovinare i salvataggi; crea prima un salvataggio rapido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チートでゲームが落ちたりセーブが壊れたりすることがあります。先にステートセーブしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "치트로 게임이 멈추거나 저장이 손상될 수 있습니다. 먼저 상태 저장을 하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Trapaças podem travar jogos ou corromper saves; crie um estado salvo antes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金手指可能导致游戏崩溃或损坏存档；请先创建即时存档。"
          }
        }
      }
    },
