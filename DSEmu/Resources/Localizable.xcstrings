    "Gray dot = raw stick, blue dot = calibrated. The dashed ring is the D-pad threshold.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grauer Punkt = Roh-Stick, blauer Punkt = kalibriert. Der gestrichelte Ring ist die Steuerkreuz-Schwelle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Punto gris = stick sin calibrar, punto azul = calibrado. El anillo punteado es el umbral de la cruceta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Point gris = stick brut, point bleu = calibré. L'anneau en pointillés est le seuil de la croix."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punto grigio = stick grezzo, punto blu = calibrato. L'anello tratteggiato è la soglia della croce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "灰色の点＝未補正のスティック、青い点＝補正後。破線の円は十字キーのしきい値です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회색 점 = 원본 스틱, 파란 점 = 보정됨. 점선 원은 방향 패드 임계값입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
