    "Add your own .nds, .gba, .gb or .gbc games with the + button: pick files, or a whole folder (subfolders included).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge eigene .nds-, .gba-, .gb- oder .gbc-Spiele mit der Taste + hinzu: Wähle Dateien oder einen ganzen Ordner (mit Unterordnern)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tus propios juegos .nds, .gba, .gb o .gbc con el botón +: elige archivos o una carpeta completa (con subcarpetas)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez vos propres jeux .nds, .gba, .gb ou .gbc avec le bouton + : choisissez des fichiers ou un dossier entier (sous-dossiers compris)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi i tuoi giochi .nds, .gba, .gb o .gbc con il pulsante +: scegli dei file o un'intera cartella (sottocartelle incluse)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "＋ボタンで自分の .nds、.gba、.gb、.gbc ゲームを追加：ファイルを選ぶか、フォルダごと（サブフォルダも含む）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "+ 버튼으로 내 .nds, .gba, .gb, .gbc 게임을 추가하세요. 파일을 고르거나 폴더 전체(하위 폴더 포함)를 선택할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione seus jogos .nds, .gba, .gb ou .gbc com o botão +: escolha arquivos ou uma pasta inteira (com subpastas)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 + 按钮添加你自己的 .nds、.gba、.gb 或 .gbc 游戏：选择文件，或整个文件夹（包括子文件夹）。"
          }
        }
      }
    },
